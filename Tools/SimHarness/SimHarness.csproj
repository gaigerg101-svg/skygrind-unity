    <Compile Include="../../Assets/Scripts/Game/Bot/*.cs" />
    <Compile Include="../../Assets/Scripts/Game/Tape/*.cs" />
    <!-- NIGHT15 U3-28.6 (builder G): builder P's UnityEngine-free map pipeline and DRYDOCK's plan conversion (its
         Editor half is under #if UNITY_EDITOR), for mapgen / mapvalidate (Harness.MapGen.cs). -->
