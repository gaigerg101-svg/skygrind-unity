<Project Sdk="Microsoft.NET.Sdk">
  <!-- NIGHT14 (the shared types): the sim composition (SurvivalSim, no UnityEngine) compiled outside Unity with
       Skygrind.Core, so headless runs (the fingerprint, two runs on one composition, the AUTOPILOT's table, a tape's
       replay) take seconds without the Editor. A fast loop beside the Editor, not the gate: the gate is Unity's EditMode
       run (Mono) and the Player. Every Game file it compiles must stay free of UnityEngine (Shim.cs stands in for the
       two Unity-side names the sim reads: Flow and UnityTuning.BoxDepth). Each agent's commands live in its own file
       here (Harness.<Topic>.cs). C# 9, as Unity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649;CS0169;CS8632;CS0108;CS0618;CS0067</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BaseOutputPath>../../Temp/SimHarness/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>../../Temp/SimHarness/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Game/SurvivalSim*.cs" />
    <Compile Include="../../Assets/Scripts/Game/SimFingerprint.cs" />
    <Compile Include="../../Assets/Scripts/Game/FingerprintBaseline.cs" />
    <Compile Include="../../Assets/Scripts/Game/FingerprintBaselineN18.cs" />
    <Compile Include="../../Assets/Scripts/Game/FingerprintBaselineN20.cs" />
    <Compile Include="../../Assets/Scripts/Game/Input/IPlayerInput.cs" />
